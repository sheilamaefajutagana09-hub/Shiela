.footer-brand{display:flex; align-items:center; gap:14px;}
.footer-logo{height:56px; width:auto; object-fit:contain;}
.footer-brand strong{font-family:var(--serif); color:var(--cream); display:block;}
.footer-tag{font-size:0.7rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--gold-pale);}
.footer-links{display:flex; gap:22px; font-size:0.85rem;}
.footer-links a{text-decoration:none; color:rgba(247,242,231,0.75);}
