.value-card .icon-wrap{width:46px; height:46px; border-radius:12px; background:var(--navy-deep); display:flex; align-items:center; justify-content:center; margin-bottom:18px;}
.value-card svg{width:22px; height:22px; stroke:var(--gold-bright); fill:none;}
.value-card h3{font-family:var(--serif); font-size:1.08rem; margin-bottom:8px;}
.value-card p{font-size:0.9rem; color:#5a5147;}
.bar-divider{display:flex; align-items:flex-end; justify-content:center; gap:6px; height:42px; margin:0 auto;}
