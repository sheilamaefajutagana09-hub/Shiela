.q-contact-form input, .q-contact-form textarea{width:100%; padding:11px 13px; border-radius:8px; border:1px solid rgba(247,242,231,0.25); background:rgba(247,242,231,0.04); color:var(--cream); font-family:var(--sans); font-size:0.9rem; resize:vertical;}
