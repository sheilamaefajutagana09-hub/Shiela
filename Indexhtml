.q-contact-form input:focus, .q-contact-form textarea:focus{outline:none; border-color:var(--gold);}
.q-submit{margin-top:22px; width:100%; background:var(--gold); color:var(--navy-deep); border:none; padding:14px; border-radius:8px; font-weight:700; font-size:0.9rem; letter-spacing:0.03em; cursor:pointer; transition:background .2s ease;}
.q-submit:hover{background:var(--gold-bright);}
.q-result-success{text-align:center; padding:30px 0;}
.q-result-success h3{font-family:var(--serif); font-size:1.6rem; color:var(--cream); margin-bottom:10px;}
.q-result-success p{color:rgba(247,242,231,0.65);}
.gallery{background:var(--cream); padding:88px 0;}
.gallery-grid{display:grid; grid-template-columns:repeat(4, 1fr); gap:22px;}
.gallery-card{position:relative; border-radius:16px; overflow:hidden; aspect-ratio:3/4; box-shadow:0 20px 40px -20px rgba(8,18,34,0.25);}
.gallery-card img{width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s ease;}
.gallery-card:hover img{transform:scale(1.06);}
.gallery-caption{position:absolute; left:0; right:0; bottom:0; padding:18px 16px 14px; background:linear-gradient(0deg, rgba(8,18,34,0.88) 0%, rgba(8,18,34,0.55) 55%, transparent 100%); color:var(--cream);}
.gallery-caption .g-title{font-family:var(--sans); font-weight:700; font-size:0.88rem; margin-bottom:2px;}
.gallery-caption .g-sub{font-size:0.72rem; color:rgba(247,242,231,0.7);}
@media (max-width:900px){.gallery-grid{grid-template-columns:repeat(2, 1fr);}}
@media (max-width:520px){.gallery-grid{grid-template-columns:1fr; gap:16px;} .gallery-card{aspect-ratio:16/11;}}
footer{background:var(--navy-deep); color:rgba(247,242,231,0.6); padding:44px 0 26px; border-top:1px solid var(--line);}
