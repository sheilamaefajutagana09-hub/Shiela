.roadmap .section-head p{color:rgba(247,242,231,0.72);}
.roadmap-list{counter-reset:step; border-top:1px solid rgba(247,242,231,0.15);}
.roadmap-item{counter-increment:step; display:grid; grid-template-columns:64px 1fr auto; align-items:center; gap:20px; padding:20px 6px; border-bottom:1px solid rgba(247,242,231,0.15); cursor:pointer;}
.roadmap-item .num{font-family:var(--serif); font-size:1.5rem; color:var(--gold); opacity:0.85;}
.roadmap-item .num::before{content:counter(step, decimal-leading-zero);}
.roadmap-item h4{font-family:var(--serif); font-weight:600; font-size:1.05rem;}
.roadmap-item .growth{display:flex; align-items:flex-end; gap:3px; height:22px; opacity:0.9;}
.roadmap-item .growth i{width:4px; background:var(--gold); border-radius:1px;}
.roadmap-item p.detail{grid-column:2 / 3; max-height:0; overflow:hidden; color:rgba(247,242,231,0.72); font-size:0.9rem; transition:max-height .3s ease, margin-top .3s ease; margin-top:0;}
.roadmap-item.open p.detail{max-height:120px; margin-top:8px;}
.roadmap-item.open .num{color:var(--gold-bright);}
.offer{background:var(--cream-dim); padding:80px 0;}
.offer-panel{background:var(--navy-deep); border-radius:20px; padding:44px; color:var(--cream); display:grid; grid-template-columns:1.2fr 1fr; gap:36px; align-items:center; position:relative;}
.offer-panel-decor{position:absolute; inset:0; border-radius:20px; overflow:hidden; pointer-events:none; z-index:0; grid-column:1/-1; grid-row:1/-1;}
.offer-panel-decor::before{content:""; position:absolute; right:-60px; top:-60px; width:220px; height:220px; border-radius:50%; border:1px solid var(--line);}
.offer-panel > *{position:relative; z-index:1;}
.offer-copy{grid-column:1; grid-row:1;}
.offer-form{grid-column:2; grid-row:1;}
.offer-panel h3{font-family:var(--serif); font-size:1.5rem; margin-bottom:12px;}
.offer-panel p{color:rgba(247,242,231,0.78); margin-bottom:18px; max-width:42ch;}
.offer-tags{display:flex; flex-wrap:wrap; gap:10px;}
.offer-tags span{font-size:0.78rem; border:1px solid var(--line); padding:8px 14px; border-radius:999px; color:var(--gold-pale);}
.offer-form{background:rgba(247,242,231,0.06); border:1px solid var(--line); border-radius:14px; padding:22px;}
.offer-form h4{font-size:0.85rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--gold-pale); margin-bottom:14px;}
.offer-form label{display:block; font-size:0.78rem; color:rgba(247,242,231,0.7); margin-bottom:5px; margin-top:12px;}
.offer-form input, .offer-form select{width:100%; padding:10px 12px; border-radius:8px; border:1px solid rgba(247,242,231,0.25); background:rgba(247,242,231,0.04); color:var(--cream); font-family:var(--sans); font-size:0.9rem;}
.offer-form input::placeholder{color:rgba(247,242,231,0.4);}
.offer-form button[type="submit"]{margin-top:18px; width:100%; background:var(--gold); color:var(--navy-deep); border:none; padding:13px; border-radius:8px; font-weight:700; font-size:0.92rem; cursor:pointer; transition:background .2s ease;}
.offer-form button[type="submit"]:hover{background:var(--gold-bright);}
.form-note{font-size:0.75rem; color:rgba(247,242,231,0.55); margin-top:10px;}
.form-success{display:none; margin-top:14px; font-size:0.85rem; color:var(--gold-pale); border:1px solid var(--line); padding:10px 12px; border-radius:8px;}
.form-success.show{display:block;}
.qualifier{padding:88px 0; background:var(--cream-dim); position:relative; overflow:hidden;}
.qualifier::before{content:""; position:absolute; left:-80px; bottom:-80px; width:260px; height:260px; border-radius:50%; border:1px solid var(--line);}
.qualifier::after{content:""; position:absolute; right:-100px; top:-100px; width:300px; height:300px; border-radius:50%; border:1px solid var(--line);}
.qualifier .wrap{position:relative; z-index:1;}
.q-progress{display:flex; align-items:center; justify-content:center; gap:0; max-width:520px; margin:0 auto 40px;}
.q-dot{width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--sans); font-weight:700; font-size:0.85rem; background:transparent; color:rgba(247,242,231,0.35); border:2px solid rgba(247,242,231,0.18); flex-shrink:0; transition:background .25s ease, color .25s ease, border-color .25s ease, box-shadow .25s ease;}
.q-dot.active{background:var(--gold); color:var(--navy-deep); border-color:var(--gold); box-shadow:0 0 0 5px rgba(201,154,58,0.18);}
.q-dot.done{background:var(--gold-pale); color:var(--navy-deep); border-color:var(--gold-pale);}
.q-line{flex:1; height:2px; background:rgba(247,242,231,0.15); margin:0 4px;}
.q-line.done{background:var(--gold-pale);}
.q-card{max-width:640px; margin:0 auto; background:var(--navy-mid); border:1px solid var(--line); border-radius:22px; padding:44px; box-shadow:0 40px 80px -30px rgba(0,0,0,0.5); transition:max-width .2s ease;}
.q-card.wide{max-width:720px;}
@media (max-width:600px){.q-summary-grid, .q-contact-row{grid-template-columns:1fr;} .q-card{padding:28px 22px;}}
.q-badge{display:inline-block; background:rgba(201,154,58,0.15); color:var(--gold-bright); border:1px solid var(--line); font-family:var(--sans); font-weight:700; font-size:0.68rem; letter-spacing:0.08em; padding:6px 14px; border-radius:999px; margin-bottom:16px;}
.q-title{font-family:var(--serif); font-weight:700; font-size:1.55rem; color:var(--cream); letter-spacing:0.005em; margin-bottom:26px; line-height:1.35;}
.q-options{display:flex; flex-direction:column; gap:12px;}
.q-option{display:flex; align-items:center; gap:16px; border:1px solid var(--line); border-radius:14px; padding:15px 20px; cursor:pointer; background:rgba(247,242,231,0.03); transition:border-color .15s ease, background .15s ease, transform .15s ease;}
.q-option:hover{border-color:var(--gold); background:rgba(247,242,231,0.06); transform:translateX(2px);}
.q-option.selected{border-color:var(--gold); background:rgba(201,154,58,0.12); box-shadow:0 0 0 1px var(--gold) inset;}
.q-option-letter{width:28px; height:28px; border-radius:50%; background:rgba(247,242,231,0.08); color:var(--gold-pale); border:1px solid var(--line); font-family:var(--sans); font-weight:700; font-size:0.75rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .15s ease, color .15s ease, border-color .15s ease;}
.q-option.selected .q-option-letter{background:var(--gold); color:var(--navy-deep); border-color:var(--gold);}
.q-option-text{font-family:var(--sans); font-weight:600; color:var(--cream); font-size:0.96rem;}
.q-footer{display:flex; align-items:center; justify-content:space-between; margin-top:32px; padding-top:24px; border-top:1px solid var(--line);}
.q-back{background:transparent; border:none; color:rgba(247,242,231,0.3); font-family:var(--sans); font-weight:700; font-size:0.85rem; cursor:not-allowed; padding:12px 6px; transition:color .2s ease;}
.q-back.enabled{color:rgba(247,242,231,0.75); cursor:pointer;}
.q-back.enabled:hover{color:var(--cream);}
.q-next{background:var(--gold); color:var(--navy-deep); border:none; padding:13px 28px; border-radius:999px; font-family:var(--sans); font-weight:700; font-size:0.9rem; cursor:pointer; opacity:0.4; pointer-events:none; transition:background .2s ease, opacity .2s ease, transform .15s ease;}
.q-next.enabled{opacity:1; pointer-events:auto;}
.q-next.enabled:hover{background:var(--gold-bright); transform:translateY(-1px);}
.q-done{text-align:center; padding:6px 0;}
.q-done h3{font-family:var(--serif); font-size:1.75rem; color:var(--cream); margin-bottom:10px; line-height:1.3;}
.q-done > p{color:rgba(247,242,231,0.65); margin-bottom:6px; font-size:0.95rem;}
.q-done .q-privacy-note{font-size:0.76rem; color:rgba(247,242,231,0.4); margin-bottom:26px;}
.q-summary{text-align:left; background:rgba(247,242,231,0.04); border:1px solid var(--line); border-radius:14px; padding:20px 22px; margin-bottom:26px;}
.q-summary-label{font-family:var(--sans); font-weight:700; font-size:0.68rem; letter-spacing:0.1em; color:var(--gold-bright); margin-bottom:14px;}
.q-summary-grid{display:grid; grid-template-columns:1fr 1fr; gap:14px 24px;}
.q-summary-item .q-summary-q{font-size:0.72rem; color:rgba(247,242,231,0.5); margin-bottom:3px; line-height:1.35;}
.q-summary-item .q-summary-a{font-family:var(--sans); font-weight:700; font-size:0.88rem; color:var(--cream);}
.q-contact-form{text-align:left;}
.q-contact-row{display:grid; grid-template-columns:1fr 1fr; gap:16px;}
