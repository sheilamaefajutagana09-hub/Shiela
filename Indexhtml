<style>
:root{
  --navy-deep:#081222;
  --navy:#0c1c33;
  --navy-mid:#122a49;
  --gold:#c99a3a;
  --gold-bright:#e6c25f;
  --gold-pale:#f2dfa8;
  --cream:#f7f2e7;
  --cream-dim:#efe7d6;
  --ink:#141414;
  --line:rgba(201,154,58,0.35);
  --serif:'Playfair Display', Georgia, serif;
  --sans:'Work Sans', -apple-system, BlinkMacSystemFont, sans-serif;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--sans); background:var(--cream); color:var(--ink); line-height:1.55; -webkit-font-smoothing:antialiased;}
img{max-width:100%; display:block;}
a{color:inherit;}
.wrap{max-width:1180px; margin:0 auto; padding:0 28px;}
section{position:relative;}
@media (prefers-reduced-motion: reduce){*{animation-duration:0.01ms !important; transition-duration:0.01ms !important;} html{scroll-behavior:auto;}}
.nav{position:sticky; top:0; z-index:50; background:rgba(8,18,34,0.92); backdrop-filter:blur(8px); border-bottom:1px solid var(--line);}
.nav .wrap{display:flex; align-items:center; justify-content:space-between; padding-top:12px; padding-bottom:12px;}
.nav-brand{display:flex; align-items:center; gap:12px;}
.nav-logo{height:52px; width:auto; object-fit:contain;}
.nav-cta{background:var(--gold); color:var(--navy-deep); font-weight:600; font-size:0.85rem; padding:10px 20px; border-radius:999px; text-decoration:none; white-space:nowrap; transition:background .2s ease, transform .2s ease;}
.nav-cta:hover{background:var(--gold-bright); transform:translateY(-1px);}
.hero{background:var(--navy-deep); color:var(--cream); overflow:hidden;}
.hero-grid{display:grid; grid-template-columns: 1fr 1.15fr; align-items:stretch; min-height:640px;}
.hero-photo{position:relative; min-height:420px; background-size:cover; background-position:center top; clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);}
.hero-photo::after{content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(8,18,34,0) 55%, rgba(8,18,34,0.55) 100%);}
.hero-copy{padding:64px 40px 56px 64px; display:flex; flex-direction:column; justify-content:center; gap:22px;}
.eyebrow{display:flex; align-items:center; gap:10px; font-size:0.72rem; letter-spacing:0.22em; text-transform:uppercase; color:var(--gold-pale);}
.eyebrow-logo{height:32px; width:auto; object-fit:contain;}
.hero h1{font-family:var(--serif); font-weight:600; font-size:clamp(1.9rem, 3.6vw, 2.9rem); line-height:1.18; max-width:16ch;}
.hero h1 .muted{color:rgba(247,242,231,0.62); font-weight:500; font-size:0.62em; display:block; margin-bottom:6px;}
.hero h1 .gold{color:var(--gold-bright);}
.hero p.lede{color:rgba(247,242,231,0.82); font-size:1.02rem; max-width:46ch;}
.hero-actions{display:flex; flex-wrap:wrap; gap:14px; margin-top:6px;}
.btn{display:inline-flex; align-items:center; gap:8px; padding:14px 26px; border-radius:999px; font-weight:600; font-size:0.92rem; text-decoration:none; border:1px solid transparent; transition:transform .2s ease, background .2s ease, border-color .2s ease; cursor:pointer;}
.btn-primary{background:var(--gold); color:var(--navy-deep);}
.btn-primary:hover{background:var(--gold-bright); transform:translateY(-2px);}
.btn-ghost{border-color:rgba(247,242,231,0.35); color:var(--cream);}
.btn-ghost:hover{border-color:var(--gold); color:var(--gold-pale);}
.hero-name{display:flex; align-items:center; gap:14px; margin-top:8px; padding-top:20px; border-top:1px solid rgba(247,242,231,0.16);}
.hero-name-sig{font-family:var(--serif); font-style:italic; font-size:1.35rem; color:var(--gold-bright);}
.hero-name-role{font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase; color:rgba(247,242,231,0.6);}
.social-links{display:flex; flex-wrap:wrap; gap:12px; margin-top:22px; padding-top:22px; border-top:1px solid rgba(247,242,231,0.15);}
.social-btn{display:inline-flex; align-items:center; gap:9px; padding:11px 20px; border-radius:999px; text-decoration:none; font-family:var(--sans); font-weight:700; font-size:0.85rem; color:#fff; transition:transform .15s ease, box-shadow .15s ease;}
.social-btn:hover{transform:translateY(-1px);}
.social-btn svg{width:16px; height:16px; flex-shrink:0;}
.social-btn.fb{background:#1877F2; box-shadow:0 8px 20px -8px rgba(24,119,242,0.6);}
.social-btn.yt{background:#FF0000; box-shadow:0 8px 20px -8px rgba(255,0,0,0.6);}
.social-btn.gm{background:linear-gradient(135deg,#EA4335,#4285F4); box-shadow:0 8px 20px -8px rgba(234,67,53,0.5);}
.audience{background:var(--navy); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
.audience .wrap{display:grid; grid-template-columns:repeat(4, 1fr); gap:0;}
.audience-item{padding:30px 18px; text-align:center; color:var(--cream); border-left:1px solid var(--line);}
.audience-item:first-child{border-left:none;}
.audience-item svg{width:30px; height:30px; margin:0 auto 12px; stroke:var(--gold); fill:none;}
.audience-item span{font-size:0.8rem; letter-spacing:0.05em; text-transform:uppercase; color:rgba(247,242,231,0.85);}
.section-head{max-width:640px; margin-bottom:44px;}
.section-head .kicker{display:inline-block; font-size:0.72rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--gold); margin-bottom:12px; font-weight:600;}
.section-head h2{font-family:var(--serif); font-size:clamp(1.6rem, 3vw, 2.2rem); line-height:1.25;}
.section-head p{margin-top:14px; color:#5a5147; font-size:1rem;}
.values{background:var(--cream); padding:88px 0;}
.value-grid{display:grid; grid-template-columns:repeat(4, 1fr); gap:22px;}
.value-card{background:#fff; border:1px solid #e6dcc4; border-radius:14px; padding:28px 22px; transition:transform .2s ease, box-shadow .2s ease;}
