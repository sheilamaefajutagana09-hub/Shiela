<script>
(function () {
  var popup = document.getElementById('consultPopup');
  var dialog = document.getElementById('consultDialog');
  var closeButton = document.getElementById('consultClose');
  var triggers = document.querySelectorAll('[data-consult-popup]');
  var surveyStep = document.getElementById('consultSurveyStep');
  var formStep = document.getElementById('consultFormStep');
  var progressEl = document.getElementById('consultQProgress');
  var cardEl = document.getElementById('consultQCard');
  var form = document.getElementById('investorConsultForm');
  var success = document.getElementById('investorConsultSuccess');
  var summaryEl = document.getElementById('consultSurveySummary');
  var questions = [
    { q: 'Which best describes your current situation as a property buyer?', options: ['Corporate Employee','Freelancer','Business Owner','Retiree or Planning to Retire','Overseas Filipino Worker (OFW)','Currently Looking for Work'] },
    { q: 'What type of property are you looking for?', options: ['House & Lot','Condominium','Townhouse','Lot Only','Investment Property','Not Sure Yet'] },
    { q: 'What is your main goal?', options: ['Own a Home','Upgrade My Home','Invest','Build for the Future','Buy for Family','Still Exploring'] },
    { q: 'When are you planning to buy?', options: ['As soon as possible','Within 3 months','3–6 months','6–12 months','More than a year','Just researching'] },
    { q: 'What is your estimated budget?', options: ['Below ₱1M','₱1M–₱2M','₱2M–₱3M','₱3M–₱5M','₱5M+','Not decided yet'] },
    { q: 'Where would you like to look?', options: ['Cavite','Metro Manila','Nearby Provinces','Anywhere in Luzon','Not sure yet','I need a recommendation'] }
  ];
  var letters = ['A','B','C','D','E','F'];
  var current = 0;
  var answers = [];
  var lastFocused = null;
  if (!popup || !dialog || !closeButton || !surveyStep || !formStep || !form) return;

  function resetFlow() {
    current = 0;
    answers = new Array(questions.length).fill(null);
    success.classList.remove('show');
    form.reset();
    dialog.classList.remove('form-mode');
    dialog.classList.add('survey-mode');
    formStep.hidden = true;
    surveyStep.hidden = false;
    renderProgress();
    renderQuestion();
  }
  function renderProgress() {
    progressEl.innerHTML = '';
    questions.forEach(function (question, i) {
      var dot = document.createElement('div');
      dot.className = 'q-dot' + (i < current ? ' done' : '') + (i === current ? ' active' : '');
      dot.textContent = i + 1;
      progressEl.appendChild(dot);
      if (i < questions.length - 1) {
        var line = document.createElement('div');
        line.className = 'q-line' + (i < current ? ' done' : '');
        progressEl.appendChild(line);
      }
    });
  }
  function renderQuestion() {
    var data = questions[current];
    var markup = '<span class="q-badge">QUESTION ' + (current + 1) + ' OF ' + questions.length + '</span>';
    markup += '<div class="q-title">' + data.q + '</div><div class="q-options">';
    data.options.forEach(function (option, idx) {
      var selected = answers[current] === idx ? ' selected' : '';
      markup += '<div class="q-option' + selected + '" data-idx="' + idx + '" role="button" tabindex="0">' +
        '<span class="q-option-letter">' + letters[idx] + '</span><span class="q-option-text">' + option + '</span></div>';
    });
    markup += '</div><div class="q-footer"><button type="button" class="q-back' + (current > 0 ? ' enabled' : '') + '" id="consultQBack"' + (current === 0 ? ' disabled' : '') + '>&larr; Back</button>';
    markup += '<button type="button" class="q-next' + (answers[current] !== null ? ' enabled' : '') + '" id="consultQNext">' + (current === questions.length - 1 ? 'Continue to form' : 'Next') + ' &rarr;</button></div>';
    cardEl.innerHTML = markup;
    cardEl.querySelectorAll('.q-option').forEach(function (optionEl) {
      function choose() { answers[current] = parseInt(optionEl.getAttribute('data-idx'), 10); renderQuestion(); }
      optionEl.addEventListener('click', choose);
      optionEl.addEventListener('keydown', function (event) { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); choose(); } });
    });
    document.getElementById('consultQBack').addEventListener('click', function () {
      if (current > 0) { current--; renderProgress(); renderQuestion(); }
    });
    document.getElementById('consultQNext').addEventListener('click', function () {
      if (answers[current] === null) return;
      if (current < questions.length - 1) { current++; renderProgress(); renderQuestion(); } else { showConsultForm(); }
    });
  }
  function showConsultForm() {
    summaryEl.innerHTML = '<strong>Quick assessment complete.</strong> You answered all six questions. Your responses will be included with your consultation request.';
    surveyStep.classList.add('step-leave');
    window.setTimeout(function () {
      surveyStep.hidden = true;
      surveyStep.classList.remove('step-leave');
      dialog.classList.remove('survey-mode');
      dialog.classList.add('form-mode');
      formStep.hidden = false;
      formStep.classList.add('step-enter');
      window.requestAnimationFrame(function () { formStep.classList.remove('step-enter'); });
      document.getElementById('investorName').focus();
    }, 220);
  }
  function openPopup(event) {
    if (event) event.preventDefault();
    lastFocused = document.activeElement;
    resetFlow();
    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    closeButton.focus();
  }
  function closePopup() {
    popup.classList.remove('is-open');
    popup.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }
  triggers.forEach(function (trigger) { trigger.addEventListener('click', openPopup); });
  closeButton.addEventListener('click', closePopup);
  popup.addEventListener('click', function (event) { if (event.target === popup) closePopup(); });
  document.addEventListener('keydown', function (event) { if (event.key === 'Escape' && popup.classList.contains('is-open')) closePopup(); });
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var fullName = document.getElementById('investorName').value.trim();
    var nameParts = fullName.split(/\s+/);
    var payload = {
      firstName: nameParts.shift() || '',
      lastName: nameParts.join(' '),
      email: document.getElementById('investorEmail').value,
      propertyInterest: answers[1] !== null ? questions[1].options[answers[1]] : '',
      preferredArea: answers[5] !== null ? questions[5].options[answers[5]] : '',
      clientType: document.getElementById('investorProfile').value,
      budget: document.getElementById('investorBudget').value,
      notes: document.getElementById('investorGoal').value,
      consent: document.getElementById('investorConsent').checked,
      source: 'Website consultation',
      surveyAnswers: questions.map(function (question, i) { return { question: question.q, answer: answers[i] !== null ? question.options[answers[i]] : null }; })
    };
    if (!payload.consent) return;
    submitLeadToBackend(payload, function () { success.classList.add('show'); form.reset(); }, function () {
      var answerLines = payload.surveyAnswers.map(function (item, i) { return (i + 1) + '. ' + item.question + '\n   ' + (item.answer || 'No answer'); });
      var subject = 'Investor Consultation Request from ' + fullName;
      var body = 'Name: ' + fullName + '\nEmail: ' + payload.email + '\nInvestor profile: ' + payload.clientType + '\nBudget: ' + (payload.budget || '(not specified)') + '\nGoal: ' + (payload.notes || '(not specified)') + '\n\nSurvey answers:\n\n' + answerLines.join('\n\n');
      window.location.href = 'mailto:sheilamaefajutagana09@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    });
  });
  resetFlow();
})();
</script>

