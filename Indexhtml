    { q: "Which best describes your current situation as a property buyer?", options: ["Corporate Employee","Freelancer","Business Owner","Retiree or Planning to Retire","Overseas Filipino Worker (OFW)","Currently Looking for Work"] },
    { q: "What type of property are you looking for?", options: ["House & Lot","Condominium","Townhouse","Lot Only","Investment Property","Not Sure Yet"] },
    { q: "What is your main goal?", options: ["Own a Home","Upgrade My Home","Invest","Build for the Future","Buy for Family","Still Exploring"] },
    { q: "When are you planning to buy?", options: ["As soon as possible","Within 3 months","3\u20136 months","6\u201312 months","More than a year","Just researching"] },
    { q: "What is your estimated budget?", options: ["Below \u20b11M","\u20b11M\u2013\u20b12M","\u20b12M\u2013\u20b13M","\u20b13M\u2013\u20b15M","\u20b15M+","Not decided yet"] },
    { q: "Where would you like to look?", options: ["Cavite","Metro Manila","Nearby Provinces","Anywhere in Luzon","Not sure yet","I need a recommendation"] }
  ];

  var letters = ['A','B','C','D','E','F'];
  var current = 0;
  var answers = new Array(questions.length).fill(null);
  var finished = false;

  var progressEl = document.getElementById('qProgress');
  var cardEl = document.getElementById('qCard');

  function renderProgress(){
    progressEl.innerHTML = '';
    for (var i = 0; i < questions.length; i++){
      var dot = document.createElement('div');
      dot.className = 'q-dot';
      if (i < current || (i === current && finished)) dot.classList.add('done');
      if (i === current && !finished) dot.classList.add('active');
      dot.textContent = i + 1;
      progressEl.appendChild(dot);

      if (i < questions.length - 1){
        var line = document.createElement('div');
        line.className = 'q-line';
        if (i < current) line.classList.add('done');
        progressEl.appendChild(line);
      }
    }
  }

  function renderQuestion(){
    if (finished){
      cardEl.classList.add('wide');

      var summaryHtml = '<div class="q-summary-grid">';
      questions.forEach(function(q, i){
        var ans = answers[i] !== null ? q.options[answers[i]] : '&mdash;';
        summaryHtml += '<div class="q-summary-item">' +
                          '<div class="q-summary-q">' + q.q + '</div>' +
                          '<div class="q-summary-a">' + ans + '</div>' +
                        '</div>';
      });
      summaryHtml += '</div>';

      cardEl.innerHTML =
        '<div class="q-done">' +
          '<h3>Mag-fill Up Para Makapag-consult Tayo.</h3>' +
          '<p>Gamitin ang sagot mo sa survey bilang guide sa consultation. Iwan ang iyong pangalan, email address, at mensahe.</p>' +
          '<div class="q-privacy-note">Hindi ka dadalhin sa ibang page &mdash; nasa loob mismo ng website ang form.</div>' +
          '<div class="q-summary">' +
            '<div class="q-summary-label">YOUR SURVEY ANSWERS</div>' +
            summaryHtml +
          '</div>' +
          '<form class="q-contact-form" id="qContactForm">' +
            '<div class="q-contact-row">' +
              '<div>' +
                '<label for="qFullName">Full name</label>' +
                '<input type="text" id="qFullName" name="qFullName" placeholder="Juan Dela Cruz" required>' +
              '</div>' +
              '<div>' +
                '<label for="qEmail">Email address</label>' +
                '<input type="email" id="qEmail" name="qEmail" placeholder="juan@example.com" required>' +
              '</div>' +
            '</div>' +
            '<label for="qMessage">Message</label>' +
            '<textarea id="qMessage" name="qMessage" rows="3" placeholder="Tell Sheila about your dream home..."></textarea>' +
            '<button type="submit" class="q-submit">SEND MY CONSULTATION REQUEST</button>' +
          '</form>' +
        '</div>';

      var qForm = document.getElementById('qContactForm');
      qForm.addEventListener('submit', function(e){
        e.preventDefault();

        var payload = {
          fullName: document.getElementById('qFullName').value,
          email: document.getElementById('qEmail').value,
          message: document.getElementById('qMessage').value,
          surveyAnswers: questions.map(function(q, i){
            return { question: q.q, answer: answers[i] !== null ? q.options[answers[i]] : null };
          })
        };

        function showThanks(){
          cardEl.innerHTML =
            '<div class="q-result-success">' +
              '<h3>Salamat, ' + (payload.fullName.split(' ')[0] || '') + '!</h3>' +
              '<p>Natanggap ko na ang iyong sagot at detalye. Aabutin ka ng personal na assessment sa loob ng 24 oras.</p>' +
            '</div>';
        }

        submitLeadToBackend(payload, showThanks, function(){
          var subject = 'Consultation Request from ' + payload.fullName;
          var bodyLines = payload.surveyAnswers.map(function(item, i){
            return (i + 1) + '. ' + item.question + '\\n   ' + (item.answer || 'No answer');
          });
          var body = 'Name: ' + payload.fullName + '\\nEmail: ' + payload.email +
            '\\n\\nMessage:\\n' + (payload.message || '(none)') +
            '\\n\\nSurvey answers:\\n\\n' + bodyLines.join('\\n\\n');
          var mailtoHref = 'mailto:sheilamaefajutagana09@gmail.com'
            + '?subject=' + encodeURIComponent(subject)
            + '&body=' + encodeURIComponent(body);
          window.location.href = mailtoHref;
        });
      });

      return;
    }

    cardEl.classList.remove('wide');
    var data = questions[current];
    var html = '';
    html += '<span class="q-badge">QUESTION ' + (current + 1) + ' OF ' + questions.length + '</span>';
    html += '<div class="q-title">' + data.q + '</div>';
    html += '<div class="q-options">';
    data.options.forEach(function(opt, idx){
      var selected = answers[current] === idx ? ' selected' : '';
      html += '<div class="q-option' + selected + '" data-idx="' + idx + '">' +
                '<span class="q-option-letter">' + letters[idx] + '</span>' +
                '<span class="q-option-text">' + opt + '</span>' +
              '</div>';
    });
    html += '</div>';
    html += '<div class="q-footer">' +
              '<button type="button" class="q-back' + (current > 0 ? ' enabled' : '') + '" id="qBack"' + (current === 0 ? ' disabled' : '') + '>&larr; Back</button>' +
              '<button type="button" class="q-next' + (answers[current] !== null ? ' enabled' : '') + '" id="qNext">' + (current === questions.length - 1 ? 'Finish Survey' : 'Next') + ' &rarr;</button>' +
            '</div>';
    cardEl.innerHTML = html;

    cardEl.querySelectorAll('.q-option').forEach(function(el){
      el.addEventListener('click', function(){
        answers[current] = parseInt(el.getAttribute('data-idx'), 10);
        renderQuestion();
      });
    });

    document.getElementById('qBack').addEventListener('click', function(){
      if (current > 0){
        current--;
        renderProgress();
        renderQuestion();
      }
    });

    document.getElementById('qNext').addEventListener('click', function(){
      if (answers[current] === null) return;
      if (current < questions.length - 1){
        current++;
      } else {
        finished = true;
      }
      renderProgress();
      renderQuestion();
    });
  }

  renderProgress();
  renderQuestion();
})();
</script>

